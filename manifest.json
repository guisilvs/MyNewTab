{
  "manifest_version": 3,
  "name": "My New Tab",
  "version": "2.0",
  "description": "Nova guia ultrarrápida com barra de favoritos Fluent UI integrada ao seu buscador favorito.",
  "permissions": [
    "bookmarks",
    "favicon",
    "storage",
    "tabs",
    "alarms"
  ],
  "host_permissions": [
    "*://*.google.com/*",
    "*://*.google.com.br/*",
    "*://*.duckduckgo.com/*",
    "*://*.search.yahoo.com/*",
    "*://*.search.brave.com/*"
  ],
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://www.google.com/*",
        "*://www.google.com.br/*",
        "*://duckduckgo.com/*",
        "*://*.search.yahoo.com/*",
        "*://search.brave.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["_favicon/*"],
      "matches": [
        "*://www.google.com/*",
        "*://www.google.com.br/*",
        "*://duckduckgo.com/*",
        "*://*.search.yahoo.com/*",
        "*://search.brave.com/*"
      ]
    }
  ]
}