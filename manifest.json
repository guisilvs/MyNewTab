{
  "manifest_version": 3,
  "name": "My New Tab",
  "version": "2.0",
  "description": "Personalize a Home do seu Microsoft Edge com seu buscador preferido e com barra de favoritos inteligente",
  "icons": {
    "16": "assets/icons/icon-16.png",
    "32": "assets/icons/icon-32.png",
    "48": "assets/icons/icon-48.png",
    "128": "assets/icons/icon-128.png"
  },
  "permissions": [
    "bookmarks",
    "favicon",
    "storage",
    "tabs",
    "alarms"
  ],
  "host_permissions": [
    "*://www.google.com/*",
    "*://www.google.com.br/*",
    "*://duckduckgo.com/*",
    "*://*.search.yahoo.com/*",
    "*://search.brave.com/*",
    "*://gemini.google.com/*",
    "*://claude.ai/*",
    "*://chatgpt.com/*",
    "*://www.perplexity.ai/*"
  ],
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://www.google.com/*",
        "*://www.google.com.br/*",
        "*://duckduckgo.com/*",
        "*://*.search.yahoo.com/*",
        "*://search.brave.com/*",
        "*://gemini.google.com/*",
        "*://claude.ai/*",
        "*://chatgpt.com/*",
        "*://www.perplexity.ai/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["_favicon/*"],
      "matches": [
        "*://www.google.com/*",
        "*://www.google.com.br/*",
        "*://duckduckgo.com/*",
        "*://*.search.yahoo.com/*",
        "*://search.brave.com/*",
        "*://gemini.google.com/*",
        "*://claude.ai/*",
        "*://chatgpt.com/*",
        "*://www.perplexity.ai/*"
      ],
      "use_dynamic_url": true
    }
  ]
}